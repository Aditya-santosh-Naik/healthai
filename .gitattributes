# Line endings are pinned here so a checkout behaves the same regardless of
# each contributor's core.autocrlf setting. setup.sh in particular fails with
# "bad interpreter: /usr/bin/env bash^M" if it ever reaches Linux with CRLF.
* text=auto

*.sh   text eol=lf
*.ps1  text eol=crlf

# Generated; keep it out of diffs and language stats.
frontend/package-lock.json linguist-generated=true
